# SQLite — no external database needed; file is created automatically on startup
DATABASE_URL=sqlite://novaclip.db

# Required API keys
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional
PEXELS_API_KEY=
PIXABAY_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# DigitalOcean Spaces Storage (optional)
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET_NAME=
SPACES_PUBLIC_URL=

# Paths
OUTPUT_DIR=outputs
TEMP_DIR=temp

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=10800

# Copy this file to .env in this directory before running natively:
#   copy .env.example .env
# Vite reads VITE_* variables from the frontend working directory (.env in frontend/).

# Where the backend API lives. Empty string = same origin (relative URLs,
# proxied by the dev server / nginx). Set this when the API is on another host.
VITE_API_URL=http://localhost:8000

# Copy this file to .env in this directory before running natively:
#   cp .env.example .env
# dotenv loads it from the backend working directory (backend/.env).

# SQLite - no external database needed; file is created automatically on startup
DATABASE_URL=sqlite://novaclip.db

# Required API keys
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional API keys
OPENROUTER_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
GIPHY_API_KEY=
UPLOADPOST_API_KEY=
WAVESPEED_API_KEY=

# Model selection
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THUMBNAIL_MODEL=gemini-3.1-flash-image-preview

# WaveSpeed (AI B-Roll / AI Shorts). WAVESPEED_TEMP_HOST is used to host the
# hook voiceover for premium InfiniteTalk lip-sync (default https://transfer.sh)
WAVESPEED_TEMP_HOST=
WAVESPEED_AUDIO_URL=
WAVESPEED_VIDEO_MODEL=bytedance/seedance-v1-pro-fast/text-to-video
WAVESPEED_VIDEO_RESOLUTION=480p
WAVESPEED_VIDEO_DURATION=5
WAVESPEED_CLIP_CONCURRENCY=3

# Speech-to-text (default: deepgram; other options: vosk, whisper)
STT_PROVIDER=deepgram
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
WHISPER_MODEL_PATH=models/ggml-base.bin

# Speaker diarization models (optional, for speaker-aware reframe)
PYANNOTE_SEGMENTATION_MODEL_PATH=models/segmentation-3.0.onnx
PYANNOTE_EMBEDDING_MODEL_PATH=models/wespeaker_en_voxceleb_CAM++.onnx

# DigitalOcean Spaces Storage (optional)
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET_NAME=
SPACES_PUBLIC_URL=

# Paths
OUTPUT_DIR=outputs
TEMP_DIR=temp

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_CONCURRENT_JOBS=4
MAX_VIDEO_UPLOAD_BYTES=1000000000
JOB_TIMEOUT_SECONDS=10800
